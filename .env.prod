# App
NODE_ENV = production
APP_PROTOCOL = http
APP_HOST = 0.0.0.0
APP_PORT = 80
SERVICE_NAME = "admin-api-templete"

# Memory Diagnostics
MEMORY_DIAGNOSTICS_SAMPLE_RATE = 0
