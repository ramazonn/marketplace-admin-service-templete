MEMORY_DIAGNOSTICS_HEAP_DELTA_MB = 10
MEMORY_DIAGNOSTICS_RSS_DELTA_MB  = 20
MEMORY_DIAGNOSTICS_ENABLED = true


# Swagger
SWAGGER_USERNAME = ""
SWAGGER_PASSWORD = ""

# Log
LOG_ENABLED = true

# DB
MONGO_URL = ""

# Redis
REDIS_URL = ""

# JWT
JWT_SECRET = vepInRi
JWT_EXPIRY_MS = 2592000000
SESSION_EXPIRES = 1200000
ACCESS_TOKEN_SLIDING_EXPIRY_MS = 600000

# Cloudflare
CLOUDFLARE_API_TOKEN = ""
CLOUDFLARE_ACCOUNT_ID = ""
CLOUDFLARE_ACCOUNT_HASH = ""
CLOUDFLARE_R2_ACCESS_KEY_ID = ""
CLOUDFLARE_R2_SECRET_ACCESS_KEY = ""
CLOUDFLARE_R2_BUCKET_NAME = ""
CLOUDFLARE_R2_PUBLIC_URL = ""

# SAP
SAP_URL = ""
SAP_COMPANY_DB = ""
# Basic auth credentials
SAP_USERNAME = ""
SAP_PASSWORD = ""
 # "* * * * *" - every minutte cron expression
 # "0 0-18 * * *" - every hour from 5:00 to 23:00 in Tashkent time zone
SAP_DAILY_SYNC_SCHEDULE = "*/10 * * * *"
SAP_DAILY_SYNC_ENABLED = true

# Firebase
FIREBASE_PROJECT_ID = ""
FIREBASE_PRIVATE_KEY = ""
FIREBASE_CLIENT_EMAIL = ""

# Timezone for cron tasks
TZ = UTC

# Telegram
TG_REPORTS_BOT_TOKEN = ""
TG_REPORTS_GROUP_ID = ""
